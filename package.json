{
  "name": "timetrack-cli",
  "version": "0.1.0",
  "description": "Open-source CLI for timetrack. Track time from the terminal. Designed for developers and AI agents.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "timetrack": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown src/index.ts --format esm --dts",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "lint": "eslint src --ext .ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "timetrack",
    "time-tracking",
    "cli",
    "productivity",
    "ai-agent",
    "mcp",
    "developer-tools",
    "open-source"
  ],
  "author": "BoomerDev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/boomerdev/timetrack-cli.git"
  },
  "bugs": {
    "url": "https://github.com/boomerdev/timetrack-cli/issues"
  },
  "homepage": "https://github.com/boomerdev/timetrack-cli#readme",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "commander": "^12.1.0",
    "conf": "^12.0.0",
    "date-fns": "^4.4.0",
    "ora": "^8.2.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "tsdown": "^0.9.9",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
